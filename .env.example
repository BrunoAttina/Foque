# Copie para .env.local e preencha com os valores do projeto no Supabase.
# Project URL: Settings → Data API. Publishable key: Settings → API Keys.
# Nunca use aqui a Secret key nem a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
